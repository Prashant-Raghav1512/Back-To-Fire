# Neon Postgres connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
#
# Used only by scripts/fetch-content.mjs (a build-time script). It is never
# shipped to the browser. Locally it's optional — without it the build just
# keeps the already-committed src/data/*.json files. In CI it's read from
# a GitHub Actions secret (Settings -> Secrets and variables -> Actions).
DATABASE_URL=

# Base URL of the data API Cloudflare Worker (see cloudflare-worker-data/)
# that every browser-side Neon call (contact form, enrollments, membership,
# Community, friends, DMs, translation cache — every src/lib/*.ts file that
# used to import @neondatabase/serverless directly) now goes through
# instead. This is just an endpoint address, not a secret — the real Neon
# connection string and CLERK_SECRET_KEY live server-side as Worker secrets
# (`wrangler secret put`), never in this app's env vars. For local dev,
# point this at `npx wrangler dev`'s local URL — see
# cloudflare-worker-data/README.md.
VITE_DATA_API_URL=

# Base URL of the Groq proxy Cloudflare Worker (see cloudflare-worker/) that
# both the main chatbot (src/lib/groqChat.ts) and the Tools page's
# food-to-protein chatbot (src/lib/proteinChat.ts) call. This is just an
# endpoint address, not a secret — the actual Groq API keys live server-side
# as Worker secrets (`wrangler secret put`), never in this app's env vars.
# For local dev, point this at `npx wrangler dev`'s default
# http://localhost:8787 — see cloudflare-worker/README.md.
VITE_GROQ_PROXY_URL=

# NOTE: no Groq key for the Articles page's translator
# (src/lib/articleTranslate.ts, used by ArticleModal.tsx) — it calls Google
# Translate's free, keyless endpoint directly and caches results via
# VITE_DATA_API_URL above (no separate var needed). An earlier Groq-based
# version was replaced after testing showed it wasn't reliable enough — see
# db/schema.sql's article_translations comment.

# Clerk publishable key (dashboard.clerk.com -> your app -> API Keys),
# used by src/main.tsx to power sign-in/sign-up. Unlike the vars above,
# this one is designed by Clerk to be public — it identifies the Clerk app,
# it isn't a secret. Email/password sign-up must be enabled for this Clerk
# app (it is by default), which is also what gives you the built-in
# "Forgot password?" reset flow for free, no extra code required.
VITE_CLERK_PUBLISHABLE_KEY=

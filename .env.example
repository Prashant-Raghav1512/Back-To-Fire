# Neon Postgres connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
#
# Used only by scripts/fetch-content.mjs (a build-time script). It is never
# shipped to the browser. Locally it's optional — without it the build just
# keeps the already-committed src/data/*.json files. In CI it's read from
# a GitHub Actions secret (Settings -> Secrets and variables -> Actions).
DATABASE_URL=

# Neon connection string used directly from the browser by the contact form
# (src/lib/contact.ts), enrollments (src/lib/enrollments.ts), and the
# Community tab (src/lib/community.ts). Unlike DATABASE_URL above, this one
# IS shipped to the browser on purpose — Neon has no way to scope a
# browser-connectable role below full database access, so anyone can
# already extract this from the built JS. Use a role dedicated to this (see
# the "contact_public" role) so it can be rotated independently if it's
# ever abused.
VITE_NEON_CONTACT_URL=

# Base URL of the Groq proxy Cloudflare Worker (cloudflare-worker/, see its
# README for deploying it) — used by both the main chatbot
# (src/lib/groqChat.ts) and the Tools page's protein estimator
# (proteinChat.ts). Unlike the old VITE_GROQ_API_KEY/VITE_GROQ_PROTEIN_API_KEY
# this replaces, this is NOT a secret — it's just the Worker's URL. The
# actual Groq keys live server-side as the Worker's own GROQ_CHAT_KEY /
# GROQ_PROTEIN_KEY secrets (set via `wrangler secret put`), never as an env
# var in this app at all.
VITE_GROQ_PROXY_URL=

# NOTE: no Groq key for the Articles page's translator
# (src/lib/articleTranslate.ts, used by ArticleModal.tsx) — it calls Google
# Translate's free, keyless endpoint directly and caches results in Neon
# (VITE_NEON_CONTACT_URL above already covers it, no separate var needed).
# An earlier Groq-based version was replaced after testing showed it wasn't
# reliable enough — see db/schema.sql's article_translations comment.

# Clerk publishable key (dashboard.clerk.com -> your app -> API Keys),
# used by src/main.tsx to power sign-in/sign-up. Unlike the vars above,
# this one is designed by Clerk to be public — it identifies the Clerk app,
# it isn't a secret. Email/password sign-up must be enabled for this Clerk
# app (it is by default), which is also what gives you the built-in
# "Forgot password?" reset flow for free, no extra code required.
VITE_CLERK_PUBLISHABLE_KEY=

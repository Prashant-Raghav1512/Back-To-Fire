# --- Server-side (set these in the Vercel project, never commit real values) ---

# Neon Postgres connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Origin allowed to call the API, e.g. https://<username>.github.io
ALLOWED_ORIGIN=

# --- Frontend (Vite, public — safe to expose) ---

# Base URL of the deployed API (the Vercel project URL, no trailing slash)
VITE_API_URL=
